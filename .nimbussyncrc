# NimbusSync local build configuration.
# This file is safe to commit. Do not put certificates, private keys, tokens,
# passwords, provisioning profile contents, or signed URLs here.
# Command-line environment variables take precedence over these values.

# Unified local paths and build defaults.
NIMBUSSYNC_TEST_BUILD_ROOT="${NIMBUSSYNC_TEST_BUILD_ROOT:-$ROOT/.build/ci-tests}"
NIMBUSSYNC_APP_BUILD_ROOT="${NIMBUSSYNC_APP_BUILD_ROOT:-$ROOT/.build/ci}"
NIMBUSSYNC_RELEASE_BUILD_ROOT="${NIMBUSSYNC_RELEASE_BUILD_ROOT:-/tmp/nimbussync-release}"
NIMBUSSYNC_DIST_DIR="${NIMBUSSYNC_DIST_DIR:-$ROOT/Dist}"
NIMBUSSYNC_VERSION="${NIMBUSSYNC_VERSION:-0.1.0}"

# Unsigned/signed application build defaults.
NIMBUSSYNC_CONFIGURATION="${NIMBUSSYNC_CONFIGURATION:-Debug}"
NIMBUSSYNC_SIGNING_MODE="${NIMBUSSYNC_SIGNING_MODE:-unsigned}"
NIMBUSSYNC_APP_GROUP_IDENTIFIER="${NIMBUSSYNC_APP_GROUP_IDENTIFIER:-group.ai.tiylabs.nimbussync}"

# Development signing defaults.
NIMBUSSYNC_ARCH="${NIMBUSSYNC_ARCH:-$(uname -m)}"
NIMBUSSYNC_ALLOW_DEVICE_REGISTRATION="${NIMBUSSYNC_ALLOW_DEVICE_REGISTRATION:-0}"
NIMBUSSYNC_OPEN_APP="${NIMBUSSYNC_OPEN_APP:-0}"

# Rust native artifact default.
NIMBUSSYNC_RUST_TARGETS="${NIMBUSSYNC_RUST_TARGETS:-aarch64-apple-darwin}"

# Release packaging defaults.
NIMBUSSYNC_RELEASE_ARCHES="${NIMBUSSYNC_RELEASE_ARCHES:-arm64}"
NIMBUSSYNC_CODE_SIGNING_ALLOWED="${NIMBUSSYNC_CODE_SIGNING_ALLOWED:-NO}"
NIMBUSSYNC_REQUIRE_SIGNED_RELEASE="${NIMBUSSYNC_REQUIRE_SIGNED_RELEASE:-0}"

# Required only for local manual signing. Uncomment and fill with non-secret
# identifiers/profile UUIDs when using Scripts/ci/build-app.sh signed mode.
# NIMBUSSYNC_DEVELOPMENT_TEAM=
# NIMBUSSYNC_CODE_SIGN_IDENTITY=
# NIMBUSSYNC_APP_PROFILE=
# NIMBUSSYNC_FILE_PROVIDER_PROFILE=
# NIMBUSSYNC_FILE_PROVIDER_UI_PROFILE=
